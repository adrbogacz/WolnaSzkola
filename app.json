{
  "expo": {
    "name": "WolnaSzkoła",
    "slug": "wolnaszkola",
    "version": "1.0.19",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wolnaszkola",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.wolnaszkola.app",
      "infoPlist": {
        "CFBundleDisplayName": "WolnaSzkoła"
      }
    },
    "android": {
      "package": "pl.wolnaszkola.app",
      "versionCode": 21,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA"
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C45C26",
          "defaultChannel": "messages",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true,
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class expo.modules.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
